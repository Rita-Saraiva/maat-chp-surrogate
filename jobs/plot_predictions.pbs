#!/bin/bash
#PBS -W group_list=dtu_00074
#PBS -A dtu_00074
#PBS -N plot_predictions
#PBS -l nodes=1:ppn=4
#PBS -l mem=32gb
#PBS -l walltime=02:00:00
#PBS -o logs/analysis/pred_${DATASET}_${MODE}_${OBJECTIVE}_${COMPONENT}_${MODEL}_${PARAMETERS}_$PBS_JOBID.out
#PBS -j oe

set -Eeuo pipefail

PROJECT_ROOT="${PROJECT_ROOT:-/home/projects/dtu_00074/scratch/ritsar_code/Surrogate}"
SIF="${SIF:-/home/projects/dtu_00074/apps/singularity_images/maat.sif}"
JOB_ID="${PBS_JOBID:-local}"

trap 'status=$?; printf "ERROR: command failed at line %s with exit status %s\n" "${LINENO}" "${status}"; exit "${status}"' ERR

: "${OBJECTIVE:?OBJECTIVE is required}"
: "${TRAIN_DATASET:?TRAIN_DATASET is required}"
: "${MODE:?MODE is required}"
: "${MODEL:?MODEL is required}"
: "${PARAMETERS:?PARAMETERS is required}"
: "${SOURCE_JOB_ID:?SOURCE_JOB_ID is required}"
# COMPONENT is only required for single-head models (multi covers all components).
if [ "${MODE}" = "single" ]; then
  : "${COMPONENT:?COMPONENT is required for MODE=single}"
fi

# DATASET defaults to TRAIN_DATASET; SPLIT defaults to val. ZONES optional.
DATASET="${DATASET:-${TRAIN_DATASET}}"
SPLIT="${SPLIT:-val}"
COMPONENT="${COMPONENT:-all}"

mkdir -p "${PROJECT_ROOT}/logs/analysis"

printf '\n============================================================\n'
printf 'Started: %s\n' "$(date)"
printf 'Job ID: %s\n' "${JOB_ID}"
printf 'Host: %s\n' "$(hostname)"
printf 'Predict plot: OBJECTIVE=%s TRAIN_DATASET=%s DATASET=%s SPLIT=%s MODE=%s MODEL=%s PARAMETERS=%s COMPONENT=%s SOURCE_JOB_ID=%s\n' \
  "${OBJECTIVE}" "${TRAIN_DATASET}" "${DATASET}" "${SPLIT}" "${MODE}" "${MODEL}" \
  "${PARAMETERS}" "${COMPONENT:-all}" "${SOURCE_JOB_ID}"
printf '============================================================\n'

cd "${PROJECT_ROOT}"
module load tools singularity/4.3.0

unset PYTHONPATH PYTHONHOME PYTHONUSERBASE
unset SINGULARITY_BIND SINGULARITY_BINDPATH APPTAINER_BIND APPTAINER_BINDPATH

# Forward a host variable into the container (Singularity strips the prefix).
fwd()     { export "SINGULARITYENV_$1=${!1}"; }
fwd_opt() { [ -n "${!1:-}" ] && fwd "$1" || true; }

# CPU-only: pin BLAS/OpenMP to the reserved cores inside the container.
CPU_THREADS="${CPU_THREADS:-4}"
for lib in OMP MKL OPENBLAS NUMEXPR; do
  export "SINGULARITYENV_${lib}_NUM_THREADS=${CPU_THREADS}"
done

# Fixed container paths / interpreter settings.
export SINGULARITYENV_PROJECT_ROOT=/mnt/project
export SINGULARITYENV_OUTPUT_ROOT=/mnt/project
export SINGULARITYENV_PYTHONPATH=/mnt/project:/mnt/project/.python_deps
export SINGULARITYENV_PYTHONNOUSERSITE=1
export SINGULARITYENV_PYTHONUNBUFFERED=1
export SINGULARITYENV_MPLBACKEND=Agg

# Run configuration forwarded into the container.
LOADER_MODE="${LOADER_MODE:-chunked}"
for v in OBJECTIVE TRAIN_DATASET DATASET SPLIT MODE MODEL PARAMETERS COMPONENT SOURCE_JOB_ID LOADER_MODE; do
  fwd "$v"
done
export SINGULARITYENV_PBS_JOBID="${JOB_ID}"

# Optional overrides, forwarded only when provided.
for v in ZONES MAX_SAMPLES BATCH_SIZE NUM_WORKERS MAX_SCATTER_POINTS SEED; do
  fwd_opt "$v"
done

printf 'Starting prediction-vs-true plotting\n'
singularity exec \
  --cleanenv \
  --pwd /mnt/project \
  --bind "${PROJECT_ROOT}:/mnt/project" \
  "${SIF}" \
  python -u -m src.plot_predictions

printf 'Finished successfully: %s\n' "$(date)"
